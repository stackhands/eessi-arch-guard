{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackhands.github.io/eessi-arch-guard/reference/json/check-submit.schema.json",
  "title": "eessi-arch-guard --check-submit --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "partition",
    "constraint",
    "target",
    "loaded",
    "missing",
    "message",
    "exit",
    "exit_semantic"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "check-submit" },
    "partition": { "type": ["string", "null"] },
    "constraint": { "type": ["string", "null"] },
    "target": { "type": ["string", "null"] },
    "loaded": { "type": ["integer", "null"], "minimum": 0 },
    "missing": {
      "type": "array",
      "items": { "type": "string" }
    },
    "message": { "type": ["string", "null"] },
    "exit": { "type": "integer", "minimum": 0, "maximum": 255 },
    "exit_semantic": {
      "type": "string",
      "enum": ["ok", "missing", "invalid"]
    }
  }
}
